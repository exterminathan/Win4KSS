<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Required by [LibraryImport] source-generated marshalling in NativeMethods.cs. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Windows looks up screen savers by file name; this is what lands in System32 as .scr.
         Screen Saver Settings shows string-table resource 1 if the .scr has one, otherwise the
         file name — .NET emits no string table, so the file name IS the display name. The
         version-resource fields below just keep Task Manager / Properties consistent. -->
    <AssemblyName>Win4KSS</AssemblyName>
    <RootNamespace>Win4K.ScreenSaver</RootNamespace>
    <AssemblyTitle>Win4KSS</AssemblyTitle>
    <Product>Win4KSS</Product>
    <Company>Win4KSS</Company>
    <Description>Win4KSS — 4K video screen saver</Description>
    <!-- Baked into Win4KSS.exe/.scr's PE resources. Explorer, the taskbar, Alt-Tab and any
         shortcut that doesn't override IconLocation all pick this up automatically, so the
         install-scr.ps1 shortcuts and Inno's [Icons] entries need no separate icon wiring. -->
    <ApplicationIcon>..\..\assets\icon\win4kss.ico</ApplicationIcon>
    <!-- Read by installer/Win4KSS.iss (passed through by scripts/build-installer.ps1) so the
         installer's version and the app's own version resource stay the same number.
         TODO(review): bump this and the installer's MyAppVersion together; nothing enforces
         they match besides this comment. -->
    <Version>1.2.0</Version>
    <FileVersion>1.2.0.0</FileVersion>

    <!-- PerMonitorV2 lives in app.manifest, not here: WinForms needs it at the Win32 level
         before any window is created, and cdima/aerial's mixed-DPI mis-sizing came from lacking it. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <!-- Publish used to be single-file (PublishSingleFile + IncludeNativeLibrariesForSelfExtract),
         bundling libmpv-2.dll/WebView2Loader.dll inside Win4KSS.exe/.scr via self-extraction.
         That self-extracting-native-DLL shape is exactly what triggered a Bitdefender heuristic
         false positive on an unsigned download (Windows Defender scans the same file clean).
         Publish now produces ordinary loose files: Win4KSS.exe/.scr beside Win4K.Core.dll,
         libmpv-2.dll, WebView2Loader.dll, etc. That loose folder is the user-scope install
         (%LOCALAPPDATA%\Programs\Win4KSS). The one exception is publish\system32\Win4KSS.scr,
         built by PublishSystem32Scr below. -->
    <!-- WebView2 ships IntelliSense XML beside its assemblies; keep it out of publish/. -->
    <AllowedReferenceRelatedFileExtensions>.pdb</AllowedReferenceRelatedFileExtensions>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Win4K.Core\Win4K.Core.csproj" />
  </ItemGroup>

  <!-- Program stays internal — it is an entry point, not API — but the screen saver
       argument forms are fiddly enough to be worth testing directly. -->
  <ItemGroup>
    <InternalsVisibleTo Include="Win4K.Tests" />
  </ItemGroup>
  <!-- The clip browser (/c) is a WebView2 page. WebView2Loader.dll is a native runtime asset
       of this package and is published loose beside the exe, like libmpv-2.dll. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- The page itself (Browser/ui/**: index.html, app.js, app.css ...) is embedded and served
       from https://app.win4k/ by BrowserForm. A wildcard, so files dropped in need no csproj
       change; logical names are "ui/<relative path>" (UiAssets normalises the slashes). Until
       index.html exists, UiAssets serves a built-in fallback page. -->
  <ItemGroup>
    <None Remove="Browser\ui\**" />
    <Content Remove="Browser\ui\**" />
    <EmbeddedResource Include="Browser\ui\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" WithCulture="false" />
  </ItemGroup>

  <!-- A screen saver is just an exe with a different extension. Windows only offers files
       named *.scr in the Screen Saver Settings dropdown. -->
  <Target Name="CopyExeToScr" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFiles="$(TargetDir)$(AssemblyName).scr" ContinueOnError="true" />
  </Target>

  <Target Name="CopyPublishedExeToScr" AfterTargets="Publish">
    <Copy SourceFiles="$(PublishDir)$(AssemblyName).exe" DestinationFiles="$(PublishDir)$(AssemblyName).scr" ContinueOnError="true" />
  </Target>

  <!-- The System32 copy: publish\system32\Win4KSS.scr, ONE file (a fixed contract path that
       install-scr.ps1 and the installer copy from).

       The Screen Saver Settings dropdown only lists .scr files in System32, but the loose DLLs
       must not go there: libmpv-2.dll and WebView2Loader.dll in System32 would shadow other
       apps' copies through the DLL search path. So this is a single-file bundle of the MANAGED
       assemblies only, which load from memory - nothing is extracted to disk, and with
       IncludeNativeLibrariesForSelfExtract=false no native DLL is bundled (that self-extracting
       shape is what Bitdefender flagged). At run time it finds no libmpv-2.dll beside itself and
       borrows the user-scope install's natives: see Win4K.Core's NativeDependencies.

       A nested Publish of this same project with different global properties. It gets its own
       obj\system32 and bin\system32 (in Core too, as the properties flow to the reference) so it
       never invalidates the normal build's outputs, and it publishes to a staging folder from
       which only the bundle is copied - the loose natives it also emits never reach system32\. -->
  <Target Name="PublishSystem32Scr" AfterTargets="Publish"
          Condition="'$(Win4KSystem32Build)' != 'true' and '$(PublishSingleFile)' != 'true'">
    <PropertyGroup>
      <_System32Staging>$(MSBuildProjectDirectory)\obj\system32\$(Configuration)\publish\</_System32Staging>
      <_System32Dir>$([MSBuild]::EnsureTrailingSlash('$(PublishDir)'))system32\</_System32Dir>
    </PropertyGroup>

    <RemoveDir Directories="$(_System32Staging)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Publish"
             Properties="Configuration=$(Configuration);Win4KSystem32Build=true;PublishSingleFile=true;IncludeNativeLibrariesForSelfExtract=false;IncludeAllContentForSelfExtract=false;IntermediateOutputPath=obj\system32\$(Configuration)\;OutputPath=bin\system32\$(Configuration)\;PublishDir=$(_System32Staging)" />

    <RemoveDir Directories="$(_System32Dir)" />
    <Copy SourceFiles="$(_System32Staging)$(AssemblyName).exe" DestinationFiles="$(_System32Dir)$(AssemblyName).scr" />
    <Message Importance="high" Text="$(MSBuildProjectName) -> $(_System32Dir)$(AssemblyName).scr (one-file, for System32)" />
  </Target>

  <!-- Microsoft.Web.WebView2's targets reference its WPF control too, which drags in WPF's
       WindowsBase 5.0 and trips MSB3277 against the WinForms-only WindowsBase 4.0. Only the
       WinForms control is used; drop the WPF reference before references are resolved. -->
  <Target Name="DropWebView2Wpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup>
      <Reference Remove="@(Reference)" Condition="'%(Filename)' == 'Microsoft.Web.WebView2.Wpf'" />
    </ItemGroup>
  </Target>

</Project>
